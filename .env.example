# Copy to .env for local development. Never commit .env.

# WhatsApp Cloud API (Meta developer console -> WhatsApp -> API setup)
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0

# Speech-to-text for voice notes (Sarvam AI)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

APP_TIMEZONE=Asia/Kolkata

# Persistent encrypted store. Leave DATABASE_PATH empty for in-memory dev mode (data is lost on restart).
DATABASE_PATH=./data/companion.db
# Generate with: python -m app.store.sqlite genkey   (keep it out of git, back it up: losing it loses all data)
STORE_KEY=
